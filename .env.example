# .env.local

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="mongodb+srv://<user>:<password>@cluster.mongodb.net/inventory?retryWrites=true&w=majority"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET="your-256-bit-secret-here-change-before-deploy"

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Email (for invoice + reset password) ────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@yourbusiness.com"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
