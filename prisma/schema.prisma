// prisma/schema.prisma
// MongoDB Atlas + Prisma ORM
// Inventory Management & Billing System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  email            String       @unique
  password         String       // bcrypt hashed
  role             UserRole     @default(STAFF)
  status           UserStatus   @default(ACTIVE)
  avatar           String?
  resetToken       String?
  resetTokenExpiry DateTime?
  lastLogin        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  bills            Bill[]
  purchases        Purchase[]
  adjustments      StockMovement[]
  auditLogs        AuditLog[]
  priceChanges     PriceHistory[]
  expenses         Expense[]

  @@index([role])
}

// ─── PRODUCTS ─────────────────────────────────────────────────────────────────

enum UnitType {
  KG
  GRAM
  LITER
  MILLILITER
  PIECE
  PACKET
  BOTTLE
  BOX
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum SellMethod {
  BY_QUANTITY
  BY_WEIGHT
}

model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  description String?
  color       String?   // hex color for UI
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Product {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  sku         String        @unique
  barcode     String?       @unique
  description String?
  image       String?       // Cloudinary URL
  categoryId  String        @db.ObjectId
  unitType    UnitType
  sellMethod  SellMethod    @default(BY_QUANTITY)
  status      ProductStatus @default(ACTIVE)
  minStock    Int           @default(10) // low-stock alert threshold
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category    Category       @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  priceHistory PriceHistory[]

  @@index([categoryId])
  @@index([status])
}

model ProductVariant {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  productId     String   @db.ObjectId
  name          String   // e.g. "500ml", "1KG"
  sku           String   @unique
  barcode       String?  @unique
  purchasePrice Float
  sellingPrice  Float
  stock         Int      @default(0)
  minStock      Int      @default(5)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product       Product        @relation(fields: [productId], references: [id])
  stockMovements StockMovement[]
  purchaseItems PurchaseItem[]
  billItems     BillItem[]
  priceHistory  PriceHistory[]

  @@index([productId])
}

// ─── PRICE HISTORY ──────────────────────────────────────────────────────────

enum PriceType {
  PURCHASE
  SELLING
}

model PriceHistory {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  productId String    @db.ObjectId
  variantId String    @db.ObjectId
  priceType PriceType
  oldPrice  Float
  newPrice  Float
  changedBy String    @db.ObjectId
  reason    String?
  createdAt DateTime  @default(now())

  product   Product        @relation(fields: [productId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  user      User           @relation(fields: [changedBy], references: [id])

  @@index([productId])
  @@index([variantId])
  @@index([createdAt])
}

// ─── SUPPLIERS ───────────────────────────────────────────────────────────────

model Supplier {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  gstin         String?
  notes         String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  purchases        Purchase[]
  purchaseReturns  PurchaseReturn[]

  @@index([name])
}

// ─── PURCHASES ───────────────────────────────────────────────────────────────

enum PurchaseStatus {
  PENDING
  RECEIVED
  PARTIAL
  CANCELLED
}

model Purchase {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  supplierId    String         @db.ObjectId
  invoiceNumber String?
  purchaseDate  DateTime
  status        PurchaseStatus @default(RECEIVED)
  subtotal      Float
  tax           Float          @default(0)
  discount      Float          @default(0)
  totalAmount   Float
  notes         String?
  createdBy     String         @db.ObjectId
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  user       User           @relation(fields: [createdBy], references: [id])
  items      PurchaseItem[]
  returns    PurchaseReturn[]

  @@index([supplierId])
  @@index([purchaseDate])
  @@index([createdAt])
}

model PurchaseItem {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  purchaseId    String   @db.ObjectId
  variantId     String   @db.ObjectId
  quantity      Float
  purchasePrice Float    // snapshot at time of purchase
  totalPrice    Float
  createdAt     DateTime @default(now())

  purchase Purchase       @relation(fields: [purchaseId], references: [id])
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@index([purchaseId])
  @@index([variantId])
}

// ─── BILLING ─────────────────────────────────────────────────────────────────

enum BillStatus {
  DRAFT
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  CREDIT
}

model Bill {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber  String        @unique  // INV-2026-000001
  billDate       DateTime      @default(now())
  customerName   String?
  customerPhone  String?
  status         BillStatus    @default(PAID)
  paymentMethod  PaymentMethod @default(CASH)
  subtotal       Float
  discount       Float         @default(0)
  discountType   String        @default("FLAT") // FLAT | PERCENT
  tax            Float         @default(0)
  taxPercent     Float         @default(0)
  totalAmount    Float
  amountPaid     Float
  change         Float         @default(0)
  notes          String?
  createdBy      String        @db.ObjectId
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user    User         @relation(fields: [createdBy], references: [id])
  items   BillItem[]
  returns SalesReturn[]

  @@index([billDate])
  @@index([createdBy])
  @@index([status])
}

model BillItem {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  billId       String   @db.ObjectId
  variantId    String   @db.ObjectId
  productName  String   // snapshot
  variantName  String   // snapshot
  quantity     Float
  unit         String   // snapshot
  sellingPrice Float    // price snapshot at time of sale
  discount     Float    @default(0)
  tax          Float    @default(0)
  totalPrice   Float
  createdAt    DateTime @default(now())

  bill    Bill           @relation(fields: [billId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([billId])
  @@index([variantId])
}

// ─── RETURNS ─────────────────────────────────────────────────────────────────

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
}

model SalesReturn {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  billId      String       @db.ObjectId
  reason      String
  status      ReturnStatus @default(PENDING)
  refundAmount Float
  items       SalesReturnItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  bill Bill @relation(fields: [billId], references: [id])

  @@index([billId])
  @@index([status])
}

model SalesReturnItem {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  returnId    String @db.ObjectId
  variantId   String @db.ObjectId
  quantity    Float
  refundPrice Float

  return SalesReturn @relation(fields: [returnId], references: [id])

  @@index([returnId])
}

model PurchaseReturn {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  purchaseId  String       @db.ObjectId
  supplierId  String       @db.ObjectId
  reason      String
  status      ReturnStatus @default(PENDING)
  totalAmount Float
  items       PurchaseReturnItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([purchaseId])
  @@index([supplierId])
}

model PurchaseReturnItem {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  returnId    String @db.ObjectId
  variantId   String @db.ObjectId
  quantity    Float
  returnPrice Float

  return PurchaseReturn @relation(fields: [returnId], references: [id])

  @@index([returnId])
}

// ─── STOCK MOVEMENTS ─────────────────────────────────────────────────────────

enum MovementType {
  PURCHASE
  SALE
  DAMAGE
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT
  INTERNAL_USAGE
  EXPIRY
}

model StockMovement {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  variantId     String       @db.ObjectId
  type          MovementType
  quantity      Float        // positive = in, negative = out
  previousStock Float
  newStock      Float
  referenceId   String?      // billId or purchaseId
  referenceType String?      // "BILL" | "PURCHASE" | "RETURN"
  notes         String?
  createdBy     String       @db.ObjectId
  createdAt     DateTime     @default(now())

  variant  ProductVariant @relation(fields: [variantId], references: [id])
  user     User           @relation(fields: [createdBy], references: [id])

  @@index([variantId])
  @@index([createdAt])
  @@index([type])
}

// ─── EXPENSES ────────────────────────────────────────────────────────────────

enum ExpenseCategory {
  RENT
  ELECTRICITY
  SALARY
  INTERNET
  MAINTENANCE
  MISCELLANEOUS
}

model Expense {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  category    ExpenseCategory
  amount      Float
  description String?
  date        DateTime
  receipt     String?         // Cloudinary URL
  createdBy   String          @db.ObjectId
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [createdBy], references: [id])

  @@index([date])
  @@index([category])
}

// ─── AUDIT LOGS ──────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  action    String   // e.g. "PRICE_UPDATED", "PRODUCT_DELETED"
  module    String   // e.g. "products", "billing"
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

// ─── NOTIFICATIONS ───────────────────────────────────────────────────────────

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  PRICE_CHANGE
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
}

model Notification {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  type      NotificationType
  title     String
  message   String
  entityId  String?
  status    NotificationStatus @default(UNREAD)
  createdAt DateTime           @default(now())

  @@index([status])
  @@index([createdAt])
}

// ─── SETTINGS ────────────────────────────────────────────────────────────────

model Settings {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  // Business Info
  businessName   String  @default("My Business")
  logo           String?
  gstin          String?
  phone          String?
  email          String?
  address        String?
  // Invoice
  invoicePrefix  String  @default("INV")
  invoiceCounter Int     @default(0)
  taxPercent     Float   @default(18)
  currency       String  @default("INR")
  currencySymbol String  @default("₹")
  // Features
  enableTax      Boolean @default(true)
  enableDiscount Boolean @default(true)
  lowStockDefault Int    @default(10)
  updatedAt      DateTime @updatedAt
}
